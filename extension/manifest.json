{
  "manifest_version": 3,
  "name": "Social Shield",
  "version": "1.0",
   "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Social Shield"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}