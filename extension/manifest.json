{
  "manifest_version": 3,
  "name": "Social Shield",
  "version": "1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Following list"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}