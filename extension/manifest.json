{
    "manifest_version": 3,
    "name": "Multiple Virtual Identities",
    "version": "1.0",
    "permissions": [
        "cookies",
        "storage",
        "sidePanel",
        "tabs",
        "alarms",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "proxy"
    ],
    "action": {
        "default_title": "Multiple Virtual Identities"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://*.instagram.com/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://*.instagram.com/*"],
            "js": ["content_scripts/common/anti_fingerprint.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://*.instagram.com/*"],
            "js": [
                "content_scripts/common/constant.js",
                "content_scripts/common/client.js",
                "content_scripts/platforms/instagram/icons.js",
                "content_scripts/platforms/instagram/follow.js",
                "content_scripts/platforms/instagram/post.js",
                "content_scripts/platforms/instagram/nav_switch.js",
                "content_scripts/content.js"
            ],
            "css": ["content_scripts/platforms/instagram/instagram.css"],
            "run_at": "document_end"
        }
    ]
}
